{
  "name": "transparencias",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Presentaciones de todos los módulos del ciclo (Slidev) — un solo git, una línea npm por presentación",
  "scripts": {
    "dev:UDXX": "slidev XX/UDXX.md",
    "build:UDXX": "slidev build XX/UDXX.md --out dist/UDXX",
    "export:UDXX": "slidev export XX/UDXX.md --output presentaciones/UDXX-claro.pdf",
    "export:UDXX:dark": "slidev export XX/UDXX.md --dark --output presentaciones/UDXX-oscuro.pdf",
    "check:UDXX": "node tools/visual-check.mjs --md XX/UDXX.md",
    "dev:UD01": "slidev PROG/UD01.md",
    "build:UD01": "slidev build PROG/UD01.md --out dist/UD01",
    "export:UD01": "slidev export PROG/UD01.md --output presentaciones/UD01-claro.pdf",
    "export:UD01:dark": "slidev export PROG/UD01.md --dark --output presentaciones/UD01-oscuro.pdf",
    "check:UD01": "node tools/visual-check.mjs --md PROG/UD01.md",
    "dev:UD02": "slidev PROG/UD02.md",
    "build:UD02": "slidev build PROG/UD02.md --out dist/UD02",
    "export:UD02": "slidev export PROG/UD02.md --output presentaciones/UD02-claro.pdf",
    "export:UD02:dark": "slidev export PROG/UD02.md --dark --output presentaciones/UD02-oscuro.pdf",
    "check:UD02": "node tools/visual-check.mjs --md PROG/UD02.md",
    "dev:UD03": "slidev PROG/UD03.md",
    "build:UD03": "slidev build PROG/UD03.md --out dist/UD03",
    "export:UD03": "slidev export PROG/UD03.md --output presentaciones/UD03-claro.pdf",
    "export:UD03:dark": "slidev export PROG/UD03.md --dark --output presentaciones/UD03-oscuro.pdf",
    "check:UD03": "node tools/visual-check.mjs --md PROG/UD03.md",
    "dev:UD04": "slidev PROG/UD04.md",
    "build:UD04": "slidev build PROG/UD04.md --out dist/UD04",
    "export:UD04": "slidev export PROG/UD04.md --output presentaciones/UD04-claro.pdf",
    "export:UD04:dark": "slidev export PROG/UD04.md --dark --output presentaciones/UD04-oscuro.pdf",
    "check:UD04": "node tools/visual-check.mjs --md PROG/UD04.md"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@slidev/cli": "^53.1.0",
    "@slidev/theme-default": "latest",
    "@slidev/types": "^53.1.0",
    "playwright-chromium": "^1.65.1"
  }
}
