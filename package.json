    "export:PROG-UD02:dark": "slidev export PROG/UD02.md --dark --output presentaciones/PROG/UD02-oscuro.pdf",
    "check:PROG-UD02": "node tools/visual-check.mjs --md PROG/UD02.md",
    "dev:PROG-UD03": "slidev PROG/UD03.md",
    "build:PROG-UD03": "slidev build PROG/UD03.md --out dist/PROG-UD03",
    "export:PROG-UD03": "slidev export PROG/UD03.md --output presentaciones/PROG/UD03-claro.pdf",
    "export:PROG-UD03:dark": "slidev export PROG/UD03.md --dark --output presentaciones/PROG/UD03-oscuro.pdf",
    "check:PROG-UD03": "node tools/visual-check.mjs --md PROG/UD03.md",
    "dev:PROG-UD04": "slidev PROG/UD04.md",
    "build:PROG-UD04": "slidev build PROG/UD04.md --out dist/PROG-UD04",
    "export:PROG-UD04": "slidev export PROG/UD04.md --output presentaciones/PROG/UD04-claro.pdf",
    "export:PROG-UD04:dark": "slidev export PROG/UD04.md --dark --output presentaciones/PROG/UD04-oscuro.pdf",
