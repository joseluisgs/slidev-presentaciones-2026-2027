{
  "name": "transparencias",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Presentaciones de todos los módulos del ciclo (Slidev) — un solo git, un solo juego de configuración",
  "scripts": {
    "dev:XX-UDXX": "slidev XX/UDXX.md",
    "build:XX-UDXX": "slidev build XX/UDXX.md --out dist/XX-UDXX",
    "export:XX-UDXX": "slidev export XX/UDXX.md --output presentaciones/XX/UDXX-claro.pdf",
    "export:XX-UDXX:dark": "slidev export XX/UDXX.md --dark --output presentaciones/XX/UDXX-oscuro.pdf",
    "check:XX-UDXX": "node tools/visual-check.mjs --md XX/UDXX.md",
    "dev:PROG-UD01": "slidev PROG/UD01.md",
    "build:PROG-UD01": "slidev build PROG/UD01.md --out dist/PROG-UD01",
    "export:PROG-UD01": "slidev export PROG/UD01.md --output presentaciones/PROG/UD01-claro.pdf",
    "export:PROG-UD01:dark": "slidev export PROG/UD01.md --dark --output presentaciones/PROG/UD01-oscuro.pdf",
    "check:PROG-UD01": "node tools/visual-check.mjs --md PROG/UD01.md",
    "dev:PROG-UD02": "slidev PROG/UD02.md",
    "build:PROG-UD02": "slidev build PROG/UD02.md --out dist/PROG-UD02",
