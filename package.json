    "export:EDS-UD02:dark": "slidev export EDS/UD02.md --dark --output presentaciones/EDS/UD02-oscuro.pdf",
    "check:EDS-UD02": "node tools/visual-check.mjs --md EDS/UD02.md",
    "dev:EDS-UD03": "slidev EDS/UD03.md",
    "build:EDS-UD03": "slidev build EDS/UD03.md --out dist/EDS-UD03",
