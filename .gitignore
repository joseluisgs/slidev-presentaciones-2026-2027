# ============================================================
# Slidev presentaciones — .gitignore
# Regla de oro: NUNCA se commitea AGENTS.md (documentación del agente).
# ============================================================

# --- Dependencias ---
node_modules/
**/node_modules/

# --- Caché de Slidev ---
# Módulos virtuales (import-glob…) que Slidev escribe en
# <carpeta-del-entry>/node_modules/.slidev, p. ej. PROG/node_modules/.slidev
**/node_modules/.slidev/
.slidev/
.vite/

# --- Builds y exports ---
dist/
dist-ssr/
.cache/
*.local

# --- Auditoría visual (informes y capturas generadas) ---
tools/out/

# --- Transparencias (PDF): NO viven aquí ---
# El profesor las copia cuando y donde diga; aquí solo se genera el output.
presentaciones/*.pdf
presentaciones/*.pptx

# --- Documentación interna del agente: NUNCA se sube ---
AGENTS.md

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*

# --- Editores / IDE ---
.idea/
.vscode/
*.swp

# --- Sistema ---
Thumbs.db
.DS_Store
desktop.ini
